{
  "name": "backend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -c \"blue,magenta\" -n \"SERVER,INNGEST\" \"bun run start:server\" \"bun run start:inngest\"",
    "dev:ngrok": "concurrently -c \"blue,magenta,cyan\" -n \"SERVER,NGROK,INNGEST\" \"bun run start:server\" \"bun run start:ngrok\" \"bun run start:inngest\"",
    "start": "bun run src/server.ts",
    "start:server": "INNGEST_DEV=1 nodemon --exec bun run src/server.ts",
    "start:inngest": "npx inngest-cli@latest dev",
    "start:ngrok": "ngrok http 5000",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.6.0",
    "@google/generative-ai": "^0.24.1",
    "@polar-sh/better-auth": "^1.8.3",
    "@polar-sh/sdk": "^0.47.0",
    "better-auth": "^1.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "inngest": "^4.2.0",
    "mongodb": "^7.1.1",
    "mongoose": "^9.4.1",
    "morgan": "^1.10.1",
    "socket.io": "^4.8.3",
    "uploadthing": "^7.7.4"
  },
  "engines": {
    "node": ">=20"
  }
}
