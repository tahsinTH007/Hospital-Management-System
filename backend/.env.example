# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma separated list of frontend origins allowed to call the API (CORS,
# Better Auth trusted origins, Socket.IO). First one is used for redirects.
FRONTEND_URL=http://localhost:5173

# Public URL of this API (used by Better Auth).
BETTER_AUTH_URL=http://localhost:5000
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Set to "true" ONLY if the frontend calls this API directly on another site
# (no /api proxy in front). Enables SameSite=None; Secure; Partitioned cookies.
CROSS_SITE_COOKIES=false

# ---- Database ----
# Include a database name, e.g. mongodb+srv://user:pass@cluster.mongodb.net/medflow
MONGO_URI=mongodb://127.0.0.1:27017/medflow

# ---- Integrations ----
UPLOADTHING_TOKEN=
GEMINI_KEY=
# Optional: override the Gemini model used for triage / x-ray analysis
# GEMINI_MODEL=gemini-3-flash-preview

# Polar (billing). POLAR_SERVER=sandbox (default) or production
POLAR_SERVER=sandbox
POLAR_PRODUCT_ID=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# First admin account for `bun run seed:admin` (all optional; defaults shown)
# ADMIN_USERNAME=tahsin
# ADMIN_PASSWORD=tahsin
# ADMIN_EMAIL=tahsin@medflow.com
# ADMIN_NAME=Tahsin Hassan
# Shared password for accounts created by `bun run seed:demo`
# DEMO_PASSWORD=medflow123

# Inngest. Locally `bun run dev` starts the dev server (INNGEST_DEV=1).
# In production (Vercel etc.) set these from https://app.inngest.com
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
