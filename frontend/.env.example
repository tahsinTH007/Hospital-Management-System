# All variables are optional in development.

# Backend origin. Leave EMPTY to call the API on the same origin (/api/...):
#  - dev:    Vite proxies /api to VITE_API_PROXY_TARGET (default http://localhost:5000)
#  - Vercel: the /api route in vercel.json proxies to the BACKEND_URL env var
# Set it only when the frontend should talk to the backend directly on another
# origin (the backend then needs CROSS_SITE_COOKIES=true).
VITE_API_URL=

# Where the Vite dev server proxies /api requests to.
VITE_API_PROXY_TARGET=http://localhost:5000

# Socket.IO server for real-time updates. Defaults to VITE_API_URL, or
# http://localhost:5000 in development. Leave empty in production when the
# backend runs on Vercel Functions (no WebSockets) – the UI polls instead.
VITE_SOCKET_URL=

# Vercel only (not exposed to the browser): public URL of the deployed backend,
# used by the /api proxy route in vercel.json, e.g. https://medflow-api.vercel.app
# BACKEND_URL=
